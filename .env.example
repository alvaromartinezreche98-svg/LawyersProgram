# Clerk authentication. Leave the publishable key empty to keep the demo access.
# Keys: Clerk Dashboard → API keys. Put real values in .env.local (never committed).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never use it in client code.
CLERK_SECRET_KEY=
# Sign-in lives on the access page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/acceso
# Staging only: show the demo role picker after a Clerk sign-in until the
# backend links Clerk users to app users. Must stay unset in production.
NEXT_PUBLIC_DEMO_LOGIN=
# Demo scope only: hide what the Product Blueprint schedules for NEXT/LATER
# (signing, payments, result approval, appointments, campaign board, pre-fill,
# activity history, firm settings, contact page). Unset shows everything.
NEXT_PUBLIC_DEMO_SCOPE=
# Base URL of this firm's Go API (e.g. https://firm-a.prerenta.es/api). Unset until connected.
NEXT_PUBLIC_API_URL=
# Clerk JWT template the Go API verifies (Clerk Dashboard → JWT templates).
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=
# DEMO ONLY: with Clerk on, show the simulated "Pagar" button (marks paid in
# the browser, charges nothing). Must stay unset for real customers.
NEXT_PUBLIC_DEMO_PAYMENT=
